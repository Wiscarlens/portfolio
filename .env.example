# Copy to .env and fill in. .env is gitignored; this file is committed as
# the reference for what the app reads.

# ─────────────────────────────────────────────────────────────────────────
# BUILD-TIME — inlined into the bundle by `next build`
#
# These must be set when the image is BUILT. Passing them to `docker run`
# does nothing: canonicals, the sitemap and OG image URLs are already
# frozen into the output. In docker-compose they belong under `args:`.
# ─────────────────────────────────────────────────────────────────────────

# Production origin. Drives canonical tags, sitemap.xml, robots.txt and
# share-image URLs. Defaults to https://wiscarlens.com when unset.
NEXT_PUBLIC_SITE_URL=https://wiscarlens.com

# Optional. Only needed for Google Search Console's meta-tag verification
# method; leave blank if you verified by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────
# RUNTIME — read by the server on each request
#
# Never give these the NEXT_PUBLIC_ prefix: that prefix ships the value to
# the browser. In docker-compose they belong under `environment:`, and
# changing one needs only a restart, not a rebuild.
#
# Read by src/app/api/contact/route.ts.
# ─────────────────────────────────────────────────────────────────────────

# Discord: Server Settings > Integrations > Webhooks > New Webhook.
# Treat the URL as a secret; anyone holding it can post to that channel.
CONTACT_DISCORD_WEBHOOK_URL=
