# Copy to .env and fill in. .env is gitignored; this file is committed as
# the reference for what the app reads. These two are the only environment
# variables the code touches.

# ─────────────────────────────────────────────────────────────────────────
# BUILD-TIME — inlined into the bundle by `next build`
#
# Must be set when the image is BUILT. Passing it to `docker run` does
# nothing: canonicals, the sitemap and OG image URLs are already frozen
# into the output. In docker-compose it belongs under `args:`.
# ─────────────────────────────────────────────────────────────────────────

# Production origin. Drives canonical tags, sitemap.xml, robots.txt and
# share-image URLs. Defaults to https://wiscarlens.com when unset.
NEXT_PUBLIC_SITE_URL=https://wiscarlens.com

# ─────────────────────────────────────────────────────────────────────────
# RUNTIME — read by the server on each request
#
# Never give this the NEXT_PUBLIC_ prefix: that prefix ships the value to
# the browser, which for a webhook URL is a straight credential leak. In
# docker-compose it belongs under `environment:`, and changing it needs
# only a restart, not a rebuild.
# ─────────────────────────────────────────────────────────────────────────

# Discord: Server Settings > Integrations > Webhooks > New Webhook.
# Treat the URL as a secret; anyone holding it can post to that channel.
# Read by src/app/api/contact/route.ts.
CONTACT_DISCORD_WEBHOOK_URL=
