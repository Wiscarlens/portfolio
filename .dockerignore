# Rebuilt inside the image; copying them in would poison the build cache
node_modules
.next
out

# VCS and editor noise
.git
.gitignore
.github
.idea
.vscode

# Never ship secrets into an image layer
.env
.env.*

# Not needed at build or runtime
Dockerfile
.dockerignore
docker-compose.yml
README.md
*.log
*.tsbuildinfo
npm-debug.log*
